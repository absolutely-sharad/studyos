# Copy to .env for local development. In production set these in your host's environment,
# never in a file in the image or the repository.

# ── Database (PostgreSQL 15+ with the pgvector extension: Supabase, Neon, or local) ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studyos"
# Connections per server instance (default 10). Use 1 or 2 on serverless hosts behind a pooler.
# DATABASE_POOL_MAX=10

# ── Auth.js ── generate with: npx auth secret   (at least 32 characters in production)
AUTH_SECRET=""
# The public address of the app. Needed in production on most hosts.
# AUTH_URL="https://studyos.example.com"
# Set to true when running behind your own reverse proxy or load balancer (not needed on Vercel).
# AUTH_TRUST_HOST=true
# Optional: enables "Continue with Google"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── AI (optional) ── without a key, StudyOS uses its built-in syllabus parser
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# ── Storage ──
# local     a folder on this machine's disk (development, or one server with a persistent volume)
# supabase  a private Supabase Storage bucket (required on serverless hosts such as Vercel)
STORAGE_DRIVER="local"
UPLOAD_DIR=".uploads"
# Only for STORAGE_DRIVER=supabase. Create the bucket first and keep it private.
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""   # server-only secret: never expose it to the browser
# SUPABASE_STORAGE_BUCKET="studyos-documents"

# Files read at the same time per server instance (multi-file uploads queue behind this)
PROCESSING_CONCURRENCY=3

# ── Operations ──
# debug | info | warn | error. Defaults to info in production and debug in development.
# LOG_LEVEL=info

# ── Branding / attribution ──
# NEXT_PUBLIC_* values are baked in when the app is built, so set them before `npm run build`.
# NEXT_PUBLIC_APP_URL="https://studyos.example.com"   # canonical links, sitemap, social previews
NEXT_PUBLIC_APP_NAME="StudyOS"
NEXT_PUBLIC_COMPANY_NAME="Sharad Solutions"
NEXT_PUBLIC_DEVELOPER_NAME="Sharad Singh Kushwaha"
NEXT_PUBLIC_GITHUB_URL="https://github.com/absolutely-sharad"
NEXT_PUBLIC_LINKEDIN_URL=""
SECURITY_CONTACT_EMAIL=""
